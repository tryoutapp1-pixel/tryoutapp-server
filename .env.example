NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=tryout_app
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tryout-app-private
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM="Tryout App <no-reply@tryout-app.test>"

APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

MAX_IMAGE_SIZE=5242880
MAX_MATERIAL_SIZE=26214400

PREMIUM_PRICE=300000
PREMIUM_DURATION_DAYS=365
MIDTRANS_SIGNATURE_SECRET_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
